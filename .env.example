# ======================================================================
# Copie para .env.local (Next.js) e/ou exporte no worker. NUNCA faça commit.
# ======================================================================

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # só servidor e worker
SUPABASE_BUCKET=media

# --- Admin: e-mails que podem entrar em /admin (separados por vírgula) ---
ADMIN_EMAILS=contato@aquilaoliveira.com

# --- Frame.io V4 (Adobe Developer Console) ---
FRAMEIO_CLIENT_ID=
FRAMEIO_CLIENT_SECRET=
FRAMEIO_AUTH_MODE=oauth               # oauth (login de usuário) | s2s (servidor-a-servidor, Enterprise)
FRAMEIO_SCOPES=openid,AdobeID,offline_access,email,profile,additional_info.roles
FRAMEIO_REDIRECT_URI=https://SEU-SITE/api/frameio/oauth/callback
FRAMEIO_ACCOUNT_ID=
FRAMEIO_FOLDER_ID=                    # a pasta que dispara o fluxo
FRAMEIO_WEBHOOK_SECRET=               # devolvido ao registrar o webhook
FRAMEIO_EVENTS=file.ready             # eventos aceitos, separados por vírgula
FRAMEIO_DOWNLOAD_PREFERENCE=original,high_quality,efficient

# --- Acionar o worker na hora (opcional; sem isto o worker roda a cada 5 min) ---
GITHUB_DISPATCH_TOKEN=                # token fino com permissão "Contents: write" no repositório
GITHUB_REPOSITORY=aquilaolvr/aquilaoliveira-site

# --- Worker ---
WORKER_POLL_SECONDS=20
FRAMEIO_POLL=false                    # true = também procura arquivos novos na pasta (plano B sem webhook)
STORE_FULL_VIDEO=false                # true = sobe o vídeo inteiro para o Supabase Storage

# --- Sugestão de título e descrição pelo Claude (opcional) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
